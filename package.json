{
  "name": "oeuvre",
  "productName": "Oeuvre",
  "version": "1.2.0",
  "description": "A local music player for listening to and organizing your own work.",
  "main": "src/main/main.mjs",
  "type": "module",
  "private": true,
  "author": "Freeman Edwards",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build-renderer.mjs --watch & electron .",
    "dist:mac": "node scripts/package-mac.mjs",
    "test": "node test/make-fixtures.mjs && node --test test/*.test.mjs",
    "test:e2e": "node scripts/build-renderer.mjs && node test/e2e/run.mjs"
  },
  "dependencies": {
    "music-metadata": "^11.10.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "@preact/signals": "^2.11.4",
    "electron": "^45.4.1",
    "esbuild": "^0.28.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-preact": "^1.75.0",
    "marked": "^18.0.0",
    "pdfjs-dist": "^6.5.438",
    "preact": "^10.27.0"
  }
}
